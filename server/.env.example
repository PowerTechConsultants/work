NODE_ENV=development
# The single stable app port. The desktop trigger, START.bat and the Startup
# entry all use this. In `npm run dev` the API moves to 42781 and Vite keeps 42780.
PORT=42780
# API_PORT overrides PORT when set (workaround for port conflicts)
# API_PORT=42781
# Bind address: localhost only. Set HOST=0.0.0.0 to expose on the LAN.
HOST=127.0.0.1
# Serve the built frontend (web/dist) from the same port → single origin.
SERVE_STATIC=true

# Localhost only
CORS_ORIGIN=http://localhost:42780,http://127.0.0.1:42780
APP_URL=http://localhost:42780

# MySQL 8 — start the service first (net start MYSQL80 as Administrator)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_DATABASE=hr
# Optional: full connection string (takes precedence over the MYSQL_* values above)
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/hr

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_access_32_chars_min__________________
JWT_REFRESH_SECRET=change_me_refresh_32_chars_min_________________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
COOKIE_SECURE=false
# Set to "1" (or "loopback") only when running behind a reverse proxy
TRUST_PROXY=0

# Files
UPLOAD_DIR=uploads
# local (default) | s3
STORAGE_PROVIDER=local
BACKUP_DIR=backup
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# First-run admin bootstrap
ADMIN_EMAIL=admin@power-tech.group
ADMIN_PASSWORD=change_me_admin_12+chars!

# Email (SMTP) — OPTIONAL. Leave empty to run with in-app notifications only.
# Forgot/reset password needs SMTP to deliver.
EMAIL_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
