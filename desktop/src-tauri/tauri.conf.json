{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkTracker",
  "version": "1.0.0",
  "identifier": "group.power-tech.worktracker",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build -w server && npm run build -w web",
    "devUrl": "http://localhost:42780",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkTracker",
        "url": "http://localhost:42780",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "copyright": "Power Tech Consultants",
    "shortDescription": "WorkTracker Desktop",
    "longDescription": "HR Employee Work Tracker - Attendance, Tasks, Leaves, Analytics",
    "icon": ["../web/public/favicon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
