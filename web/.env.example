# Local: the app is served from a single origin (Express on 42780 serves API + built
# frontend), so leave VITE_API_URL empty to use the page's own origin.
# Set it only when the API lives on a different host (e.g. a separate Hostinger app).
VITE_API_URL=
# Legacy Next.js name, still honored as fallback (see web/src/lib/env.ts).
NEXT_PUBLIC_API_URL=

# Dev mode only: Vite runs on 42780 and proxies /api + /socket.io to the dev API port.
VITE_API_PORT=42781
# Vite dev server port (defaults to 42780).
WEB_PORT=42780
